# Copier ce fichier vers ".env" puis remplir les valeurs.
# Le fichier .env ne doit JAMAIS être commité (voir .gitignore).

# Environnement : development | production
# En production, force HTTPS, cookies Secure, HSTS, debug désactivé.
APP_ENV=development

# Clé de signature des sessions Flask (OBLIGATOIRE en production).
# Génération : python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=

# Forcer les cookies Secure (1/0). Par défaut : 1 si APP_ENV=production.
# SESSION_COOKIE_SECURE=1

# --- Base de données ---
# Option A (recommandée) : Turso Cloud — driver HTTP pur Python
# (turso_serverless), fonctionne sous Windows, Linux et macOS.
DATABASE_URL=libsql://hagar-auth-vichbcode.aws-eu-west-1.turso.io
# Jeton d'accès : turso db tokens create hagar-auth-vichbcode
TURSO_AUTH_TOKEN=

# Option B : SQLite local (défaut si DATABASE_URL est absente)
# DATABASE_URL=sqlite:///hagar_auth.db

# Limites de débit (Flask-Limiter). Défaut : mémoire locale.
# Pour plusieurs processus/gigue, utiliser Redis :
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# Si derrière un reverse proxy (nginx...), activer ProxyFix :
# BEHIND_PROXY=1
